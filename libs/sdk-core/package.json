{
  "name": "@basen/sdk-core",
  "version": "0.0.1",
  "description": "Basen SDK Core",
  "license": "MIT",
  "files": [
    "/dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "echo '\nCORE Generate' && yarn generate-typechain",
    "generate-typechain": "typechain --target=ethers-v5 --ts-nocheck --out-dir=./src/constants/generated/ ./src/constants/abi/**/*.json",
    "clean-generated": "rimraf ./src/constants/generated",
    "clean-build": "rimraf dist",
    "clean": "yarn clean-generated && yarn clean-build",
    "dev": "tsc --noEmit --watch",
    "ts": "yarn clean-build && tsc && tsc-alias -p tsconfig.json",
    "build": "echo '\nCORE Build' && yarn ts && yarn generate && rimraf dist/js",
    "core:build": "yarn generate && yarn build",
    "publish": "yarn build && yarn npm publish --access public"
  },
  "dependencies": {
    "ethers": "^5.0.0"
  },
  "peerDependencies": {
    "ethers": "^5.0.0"
  },
  "devDependencies": {
    "@typechain/ethers-v5": "^10.2.1",
    "@types/chai": "^4.3.11",
    "@types/jest": "^29.5.12",
    "@types/rimraf": "^3.0.2",
    "chai": "4.4.1",
    "dotenv": "^16.4.5",
    "jest": "^29.2.0",
    "rimraf": "3.0.2",
    "tsc-alias": "1.8.8",
    "tslib": "2.6.2",
    "typechain": "^8.1.0",
    "typescript": "5.3.3"
  },
  "packageManager": "yarn@4.1.0"
}
